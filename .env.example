# Chloe Grains environment template
# Copy to .env.local for development. All variables are optional;
# the site runs fully without them (forms fall back to honeypot + rate limiting).

# Public site URL (used for metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for the floating chat button (E.164 digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# reCAPTCHA
# Set NEXT_PUBLIC_RECAPTCHA_VERSION to "3" (score based, invisible) or "2" (checkbox).
# Leave the site key empty to disable reCAPTCHA; a honeypot field and basic
# server side rate limiting still protect the forms.
NEXT_PUBLIC_RECAPTCHA_VERSION=3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional webhook (POST, JSON) that receives contact / share-recipe / newsletter
# submissions, for example an email API endpoint or an automation inbox.
FORMS_WEBHOOK_URL=
